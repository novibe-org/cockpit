model {
  extend novibe.cockpit {
    worker = container 'Cockpit Worker' {
      technology 'Cloudflare Worker · Cache API · Cucumber Gherkin parser · Cucumber Messages · zod · Drizzle ORM'
      description 'Serves the app, turns a branch\'s feature files into features with what its tests proved, and keeps the plan.'
    }
    app = container 'Cockpit app' {
      technology 'React · Mantine, in a palette of its own'
      description 'Where the driver chooses a branch, reads its features, sees what its tests proved, and plans them into epics.'
    }
    plan = store 'Plan' {
      technology 'Cloudflare D1'
      description 'Each repository\'s epics, in order, and the features picked into them.'
    }
  }

  driver -> novibe.cockpit.app 'chooses a branch, reads its features, sees what its tests proved, and plans them into epics'
  novibe.cockpit.app -> novibe.cockpit.worker 'asks for the branches, and a branch\'s features with their results and the plan · sends one change at a time'
  novibe.cockpit.worker -> github 'reads the branches, a branch\'s feature files, and its latest finished test run with its results, on each open, with a read-only token'
  novibe.cockpit.worker -> novibe.cockpit.plan 'reads and changes the plan of the repository it reads'
}
